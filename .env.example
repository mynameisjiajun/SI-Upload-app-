# ── Telegram ──────────────────────────────────────────────────────────────────
# Get these from https://my.telegram.org → "API development tools"
API_ID=12345678
API_HASH=your_api_hash_here

# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:ABCdef...

# Comma-separated Telegram user IDs allowed to add/remove sermons.
# Leave blank to allow everyone (good for initial testing).
ADMIN_IDS=

# ── Google Drive ──────────────────────────────────────────────────────────────
# Paste the full contents of your service account JSON key here — minified to
# a single line. Example structure (replace all values):
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"bot@project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# The folder ID from your Google Drive URL — just the ID part, not the full URL.
# Example URL: https://drive.google.com/drive/folders/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
# Folder ID:   1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
DRIVE_ROOT_FOLDER_ID=your_folder_id_here
